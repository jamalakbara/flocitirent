# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Secrets & environment
wp-config.php
.env
.env.*
!.env.example

# Database dumps & backups
*.sql
*.sql.gz
*.zip
*.tar.gz
*.bak

# Logs
*.log

# Server config (generated by WordPress, environment-specific)
.htaccess

# WordPress core (reinstall via WordPress / WP-CLI)
/wp-admin/
/wp-includes/
/index.php
/license.txt
/readme.html
/wp-*.php
!/wp-config-sample.php
/xmlrpc.php

# wp-content: ignore everything by default, then whitelist our own code
/wp-content/*
!/wp-content/index.php
!/wp-content/plugins/
!/wp-content/themes/
!/wp-content/mu-plugins/

# Runtime / generated
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/backup*/
/wp-content/ai1wm-backups/
/wp-content/updraft/

# Third-party plugins (reinstall from wordpress.org / vendor)
/wp-content/plugins/*
!/wp-content/plugins/index.php
# Add custom plugins here, e.g.:
# !/wp-content/plugins/flociti-core/

# Third-party themes
/wp-content/themes/*
!/wp-content/themes/index.php
# Add custom / child theme here, e.g.:
# !/wp-content/themes/astra-child/

# Dependencies
node_modules/
vendor/
