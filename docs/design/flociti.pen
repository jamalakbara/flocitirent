                              "context": "div",
                              "width": "fill_container",
                              "height": 447.19,
                              "layout": "vertical",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "foRrd",
                                  "name": "HARGA TERMASUK : Transport Private sesua",
                                  "context": "p",
                                  "fill": "#000000",
                                  "content": "HARGA TERMASUK :\n \nTransport Private sesuai jumlah peserta\nAkomodasi 1 malam di Hotel pilihan based on twin share standard room.\n1x Makan Pagi, 2x Makan Siang\nTiket Objek wisata : Floating Market dan Farmhouse Lembang\nTol dan Parkir\nAir Mineral 1 Botol/hari\nDriver sebagai Guide untuk 2-14 Orang / Lokal Guide untuk min. 25 Orang\nSouvenir\n \nHARGA TIDAK TERMASUK :\n \nTips Guide local dan driver\nBiaya pribadi : Telp, laundry, extrabill, minibar dll.\nHigh season surcharge periode : Natal, Tahun Baru, Liburan Sekolah, Idul Fitri, dll.\n \nKETERANGAN :\n \nHarga dapat berubah sewaktu-waktu tanpa pemberitahuan terlebih dahulu.\nNon refundable (tidak ada pengembalian uang atas biaya tour yang tidak terpakai).",
                                  "lineHeight": 1.18,
                                  "fontFamily": "Outfit",
                                  "fontSize": 17,
                                  "fontWeight": "normal",
                                  "letterSpacing": -0.37
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
