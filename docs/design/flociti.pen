                        },
                        {
                          "type": "text",
                          "id": "mvOKg",
                          "name": "Dengan visi menjadi perusahaan penyedia ",
                          "context": "p",
                          "fill": "#ffffff",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 54.47,
                          "content": "Dengan visi menjadi perusahaan penyedia sewa mobil dan paket wisata yang handal serta memberikan kesan berarti bagi para pelanggan, Flociti mulai beroperasional sejak tahun 2017 di kota Bandung.",
                          "lineHeight": 1.24,
                          "fontFamily": "Outfit",
                          "fontSize": 22,
                          "fontWeight": "normal",
                          "letterSpacing": 0.35
                        },
                        {
                          "type": "text",
                          "id": "x0pb3",
                          "name": "Menanamkan tujuan untuk menghadirkan kem",
                          "context": "p",
                          "fill": "#ffffff",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 54.47,
                          "content": "Menanamkan tujuan untuk menghadirkan kemudahan dan kenyamanan di setiap perjalanan, Flociti menyediakan berbagai pilihan kendaraan dan paket wisata menarik yang didukung dengan segenap tim berpengalaman.",
                          "lineHeight": 1.24,
                          "fontFamily": "Outfit",
                          "fontSize": 22,
                          "fontWeight": "normal",
                          "letterSpacing": 0.35
                        },
                        {
                          "type": "text",
                          "id": "s3DcI",
                          "name": "Setiap perjalanan pelanggan telah menjad",
                          "context": "p",
                          "fill": "#ffffff",
                          "textGrowth": "fixed-width-height",
                          "width": "fill_container",
                          "height": 54.47,
                          "content": "Setiap perjalanan pelanggan telah menjadi perjalanan Flociti untuk terus berupaya memberikan pelayanan terbaik demi meraih kepuasan Anda.",
                          "lineHeight": 1.24,
                          "fontFamily": "Outfit",
                          "fontSize": 22,
                          "fontWeight": "normal",
                          "letterSpacing": 0.35
                        },
